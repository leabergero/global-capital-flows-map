# Copiá este archivo a ".env" y poné tus API keys.
# El .env real está en .gitignore: NUNCA se sube al control de versiones.
# Si dejás placeholders, el backend degrada a DEMO (datos sintéticos).

# --- FMP (Financial Modeling Prep) ---------
# Plan Free: solo históricos de precio (vía yfinance, gratis)
# Plan Pro: recupera COT, economic, ETF flows en vivo
FMP_API_KEY=tu_key_regenerada

# --- FRED (Federal Reserve Economic Data) ---
# Gratis. Obtené en: https://fred.stlouisfed.org/docs/api/
# Usada por: macro.py para indicadores económicos (tasas, CPI, etc.)
# Sin key: economic indicators caen a demo
FRED_API_KEY=tu_fred_key

# --- Quandl (COT - Commitment of Traders) ---
# Gratis. Obtené en: https://www.quandl.com/ (registro libre)
# Usada por: compute/cot.py para posicionamiento de especuladores
# Sin key: COT cae a demo
QUANDL_API_KEY=tu_quandl_key

# --- OpenBB (opcional, pesado) ----
# Gratis. Noticias globales + acceso avanzado a FRED
# Sin instalación: noticias caen a demo
# Descomenta solo si instalaste OpenBB (pip install openbb)
# OPENBB_API_KEY=tu_openbb_key
